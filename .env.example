# ──────────────────────────────────────────────────────────────────────────────
# OpenNotepad environment variables
#
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# ──────────────────────────────────────────────────────────────────────────────

# Public Supabase project credentials (safe to expose to the browser).
# Find them in your Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose this to the client or commit it.
# Supabase dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the running app (e.g. http://localhost:3000 in dev).
NEXT_PUBLIC_APP_URL=

# Operator-chosen secret path that middleware rewrites to /internal-admin,
# e.g. /ops-7f3k. Must start with "/". Never committed with a real value.
# (Used in a later phase — the admin surface.)
ADMIN_SECRET_PATH=

# AES-256-GCM key used to encrypt stored Gemini API keys at rest.
# Generate with: openssl rand -base64 32
# (Used in a later phase — the AI assistant.)
ENCRYPTION_KEY=

# Optional — when present, rate limiting uses Upstash Redis instead of the
# durable Postgres `rate_limits` table. (Used in a later phase.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
